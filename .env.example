# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# HTTP port for the API + widget.
PORT=3000

# Required for POST /api/agents/:id/reindex. Pick any long random string.
ADMIN_TOKEN=

# Model and effort used to answer questions. "low" effort keeps chat fast and cheap;
# raise to "medium"/"high" for knowledge bases where answers need more reasoning.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Chat requests allowed per visitor IP per minute (protects your API bill).
RATE_LIMIT_PER_MIN=20
