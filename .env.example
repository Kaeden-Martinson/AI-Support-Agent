# Copy to .env and fill in.

# Which model answers questions: "claude" (default, needs ANTHROPIC_API_KEY) or "ollama"
# (a local open-weights model, nothing leaves your server). See docs/deployment.md.
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=

# HTTP port for the API + widget.
PORT=3000

# Required for POST /api/agents/:id/reindex. Pick any long random string.
ADMIN_TOKEN=

# Model and effort used to answer questions. "low" effort keeps chat fast and cheap;
# raise to "medium"/"high" for knowledge bases where answers need more reasoning.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Chat requests allowed per visitor IP per minute (protects your API bill).
RATE_LIMIT_PER_MIN=20

# Set to 1 to log visitor questions to data/agents/<id>/log.jsonl (no IPs; see docs/configuration.md).
# Summarize with: npm run cli -- report <agent-id>
LOG_QUESTIONS=0
LOG_RETENTION_DAYS=30

# --- Only used when LLM_PROVIDER=ollama ---
# Where Ollama is listening, and which pulled model to use (run `ollama pull <model>` first).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Context window in tokens. Raise it if you raise OLLAMA_PASSAGES; costs GPU memory.
OLLAMA_NUM_CTX=8192
# Knowledge-base passages given to the model per question.
OLLAMA_PASSAGES=6
# Set to 1 to also let the model run its own searches (needs a model with tool calling).
OLLAMA_TOOLS=0
